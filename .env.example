# Cloud providers
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=

# Rynne can automatically split complex requests across independent model keys.
# Actual parallelism is also capped by healthy keys/quota groups.
NOVA_MAX_SUBAGENTS=6

# Local STT: whisper.cpp
# Рекомендуется ggml-tiny.bin или ggml-base.bin.
NOVA_LOCAL_STT_EXECUTABLE=
NOVA_LOCAL_STT_MODEL=
NOVA_LOCAL_STT_LANGUAGE=ru
NOVA_LOCAL_STT_TIMEOUT=120

# Local LLM: llama.cpp
# Рекомендуется 1–3B Q4_K_M GGUF.
NOVA_LOCAL_LLM_EXECUTABLE=
NOVA_LOCAL_LLM_MODEL=
NOVA_LOCAL_LLM_CONTEXT=4096
NOVA_LOCAL_LLM_MAX_TOKENS=384
NOVA_LOCAL_LLM_TEMPERATURE=0.2
NOVA_LOCAL_LLM_THREADS=4
NOVA_ENABLE_LOCAL_LLM_FALLBACK=true

# Desktop UI. The regular app uses PySide; nova_sidecar.py forces stdio.
NOVA_DESKTOP_UI=true
NOVA_DESKTOP_TRANSPORT=pyside
NOVA_PREMIUM_UI=true

RYNNE_WAKE_WORD_ENABLED=true
RYNNE_WAKE_WORD=рин
RYNNE_VOSK_MODEL=data/models/vosk
RYNNE_WAKE_WORD_SENSITIVITY=0.78
RYNNE_WAKE_COMMAND_TIMEOUT=15
# Existing NOVA_WAKE_* and NOVA_VOSK_MODEL values remain supported for upgrades.

# MCP Servers
GITHUB_TOKEN=
SLACK_TOKEN=
MCP_SQLITE_PATH=nova_memory.db
GOOGLE_DRIVE_TOKEN=
MCP_POSTGRES_CONNECTION=
JIRA_TOKEN=

# MCP servers: path to a Claude/Codex-compatible JSON config.
NOVA_MCP_CONFIG=

# Optional localhost discovery. Disabled by default: it probes local ports.
NOVA_MCP_AUTO_DISCOVERY=false
NOVA_MCP_DISCOVERY_PORTS=3000,8000,8080,8081,9000

# Personal Telegram account via the bundled local MCP server.
# Run `py scripts/setup_telegram_mcp.py`; do not commit the generated .env/session.
NOVA_TELEGRAM_MCP_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=

# Recommended Telegram integration: create a bot with @BotFather, enable
# Business Mode, connect it to your account, then paste its token in Rynne UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_STORE_PATH=

# Optional always-on Telegram Remote relay. The private rynne-cloud deployment
# receives the webhook and queues work; this Core only makes outbound HTTPS calls.
RYNNE_CLOUD_REMOTE_URL=
RYNNE_CLOUD_DEVICE_ID=windows-primary
RYNNE_CLOUD_DEVICE_TOKEN=

# Optional high-quality web search. Configurable in Rynne UI.
TAVILY_API_KEY=

# Proactive suggestions (notifications only; no autonomous side effects)
NOVA_PROACTIVE_ENABLED=true
NOVA_CONTINUOUS_LISTENING=false
NOVA_PROACTIVE_COOLDOWN_SECONDS=60
NOVA_PROACTIVE_QUIET_START=22
NOVA_PROACTIVE_QUIET_END=8
NOVA_PROACTIVE_DISABLED_KINDS=
NOVA_PROACTIVE_VISION_CHECK_SECONDS=90
NOVA_PROACTIVE_VISION_MIN_CONFIDENCE=0.70
NOVA_PROACTIVE_DISK_FREE_PERCENT=10
NOVA_PROACTIVE_DISK_FREE_GB=5
NOVA_PROACTIVE_DISK_CHECK_SECONDS=60
NOVA_PROACTIVE_STALE_PROCESS_HOURS=4
NOVA_PROACTIVE_REPOSITORY_CHECK_SECONDS=60
NOVA_PROACTIVE_UNCOMMITTED_MINUTES=30
NOVA_PROACTIVE_RESUME_PLAN_MINUTES=15
NOVA_PROACTIVE_WORKFLOW_CHECK_SECONDS=60
NOVA_PROACTIVE_WORKFLOW_LOOKBACK_DAYS=14
NOVA_PROACTIVE_WORKFLOW_MIN_REPETITIONS=3
NOVA_PROACTIVE_WEBSITE_CHECK_SECONDS=300
NOVA_PROACTIVE_BACKUP_CHECK_SECONDS=300
NOVA_PROACTIVE_PACKAGE_CHECK_SECONDS=21600
